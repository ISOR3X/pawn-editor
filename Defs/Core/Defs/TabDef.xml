<Defs>
    <PawnEditor.TabDef>
        <defName>PawnEditor_Bio</defName>
        <label>Bio</label>
        <priority>0</priority>
        <tabCategory>All</tabCategory>
        <workerClass>PawnEditor.TabWorker_PawnBio</workerClass>
        <layout>
            <section>PawnEditor_BioInfo</section>
            <flex direction="row">
                <section flexBasis="0.4" flexGrow="0">PawnEditor_BioName</section>
                <section flexBasis="0" flexGrow="1">PawnEditor_BioAge</section>
                <section flexBasis="0" flexGrow="1">PawnEditor_BioBackstory</section>
            </flex>
            <section>PawnEditor_BioSkills</section>
            <flex direction="row">
                <section flexBasis="0.6" flexGrow="1">PawnEditor_BioTraits</section>
                <section flexBasis="0.3" flexGrow="1">PawnEditor_BioAbilities</section>
            </flex>
            <flex direction="row">
                <section flexBasis="0.3" flexGrow="0" mayRequire="Ludeon.Rimworld.Ideology">PawnEditor_BioFavColor</section>
            </flex>
            <flex direction="row">
                <section flexBasis="0.3" flexGrow="0">PawnEditor_BioFaction</section>
            </flex>
        </layout>
    </PawnEditor.TabDef>
