<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_Ideology</defName>
        <workerClass>PawnEditor.SectionWorker_Ideology</workerClass>
        <layout>
            <div class="block">
                <text color="Verse.ColoredText.TipSectionTitleColor">Ideology</text>
                <div class="flex flex-row">
                    <text class="w-label mr-4">Ideology</text>
                    <button id="button" class="w-btn"/>
                </div>
            </div>
        </layout>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_IdeologyCertainty</defName>
        <workerClass>PawnEditor.SectionWorker_IdeologyCertainty</workerClass>
        <layout>
            <div class="flex flex-row">
                <text class="w-label mr-4">Certainty</text>
                <div class="block w-btn">
                    <div class="flex justify-between">
                        <text id="min" class="text-xs" color="Verse.ColoredText.SubtleGrayColor">1</text>
                        <text id="value" class="text-xs">2</text>
                        <text id="max" class="text-xs" color="Verse.ColoredText.SubtleGrayColor">3</text>
                    </div>
                    <input id="certainty" class="w-full" type="range"/>
                </div>
            </div>
        </layout>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_IdeologyRole</defName>
        <workerClass>PawnEditor.SectionWorker_IdeologyRole</workerClass>
        <layout>
            <div class="flex flex-row">
                <text id="text" class="w-label mr-4">Role</text>
                <button id="button" class="w-btn"/>
            </div>
        </layout>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_FavColor</defName>
        <workerClass>PawnEditor.SectionWorker_FavColor</workerClass>
        <layout>
            <div class="flex flex-row">
                <text id="text" class="w-label mr-4" color="Verse.ColoredText.TipSectionTitleColor">Favorite color
                </text>
                <button id="button" class="w-btn" style="max-width: 144px" label="Choose color..."/>
                <div id="container" style="width: 32px" class="p-1 h-full ml-1">
                    <div id="color_preview" class="w-full h-full"/>
                </div>
            </div>
        </layout>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_TattooFace</defName>
        <workerClass>PawnEditor.SectionWorker_TattooFace</workerClass>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_TattooBody</defName>
        <workerClass>PawnEditor.SectionWorker_TattooBody</workerClass>
    </PawnEditor.SectionDef>
</Defs>
