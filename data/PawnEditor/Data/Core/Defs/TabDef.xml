<?xml version="1.0" encoding="utf-8"?>

<Defs>
    <PawnEditor.TabDef>
        <defName>PawnEditor_Bio</defName>
        <label>Bio</label>
        <priority>0</priority>
        <tabCategory>All</tabCategory>
        <workerClass>PawnEditor.TabWorker_Pawn</workerClass>
        <layout class="flex flex-col">
            <div class="flex w-full justify-between">
                <div class="flex flex-col gap-section grow" style="max-width: 640px; min-width: 200px">
                    <section class="flex-col">PawnEditor_Info</section>
                    <section>PawnEditor_Name</section>
                    <section class="flex-col">PawnEditor_Age</section>
                </div>
                <section style="min-width: 80px; max-width: 160px">PawnEditor_Portrait</section>
            </div>
            <div class="items-end gap-section flex flex-wrap w-full">
            </div>
            <section>PawnEditor_Backstory</section>
            <section>PawnEditor_Faction</section>
            <section mayRequire="Ludeon.Rimworld.Ideology">PawnEditor_FavColor</section>
            <div mayRequire="Ludeon.Rimworld.Ideology" class="flex flex-wrap gap-section items-end">
                <section>PawnEditor_Ideology</section>
                <section>PawnEditor_IdeologyCertainty</section>
                <section>PawnEditor_IdeologyRole</section>
            </div>
            <div mayRequire="Ludeon.Rimworld.Royalty" class="flex flex-wrap gap-section items-end">
                <section>PawnEditor_EmpireTitle</section>
                <section>PawnEditor_EmpireHonor</section>
            </div>
            <section>PawnEditor_Traits</section>
            <section>PawnEditor_Skills</section>
            <section>PawnEditor_Abilities</section>
        </layout>
    </PawnEditor.TabDef>
    <PawnEditor.TabDef>
        <defName>PawnEditor_Appearance</defName>
        <label>Appearance</label>
        <priority>10</priority>
        <workerClass>PawnEditor.TabWorker_Pawn</workerClass>
        <layout>
            <section style="flex-basis: 100%">PawnEditor_Portrait</section>
            <div style="flex-direction: row; flex-wrap: wrap; flex-basis: 100%; width: 100%; justify-content: start">
                <section style="flex-grow: 1">PawnEditor_Sex</section>
                <section style="flex-grow: 1" mayRequire="Ludeon.Rimworld.Biotech">PawnEditor_Lifestage</section>
                <section style="flex-grow: 1" mayRequire="Ludeon.Rimworld.Biotech">PawnEditor_Race</section>
                <section style="flex-grow: 1" mayRequire="Ludeon.Rimworld.Biotech">PawnEditor_Xenotype</section>
            </div>
            <!--            <div style="display: flex; flex-direction: row; flex-wrap: wrap">-->
            <!--                <section style="flex-basis: 50%; flex-grow: 1">PawnEditor_ShapeHead</section>-->
            <!--                <section style="flex-basis: 50%; flex-grow: 1">PawnEditor_ShapeBody</section>-->
            <!--                <section style="flex-basis: 50%; flex-grow: 1">PawnEditor_SkinColor</section>-->
            <!--            </div>-->
            <div style="flex-direction: row; flex-wrap: wrap; width: 100%; gap: 10px">
                <section style="flex-direction: column; flex-basis: 40%; flex-grow: 1">PawnEditor_Hair</section>
                <section style="flex-direction: column; flex-basis: 40%; flex-grow: 1">PawnEditor_Beard</section>
                <!--                <section style="flex-basis: 50%; flex-grow: 1">PawnEditor_HairColor</section>-->
            </div>
            <div style="flex-direction: row; flex-wrap: wrap; width: 100%; gap: 10px"
                 mayRequire="Ludeon.Rimworld.Ideology">
                <section style="flex-direction: column; flex-basis: 40%; flex-grow: 1">PawnEditor_TattooBody</section>
                <section style="flex-direction: column; flex-basis: 40%; flex-grow: 1">PawnEditor_TattooFace</section>
                <!--                <section style="flex-basis: 50%; flex-grow: 1">PawnEditor_HairColor</section>-->
            </div>
            <!--            <div style="display: flex; flex-direction: row; flex-wrap: wrap" mayRequire="Ludeon.Rimworld.Ideology">-->
            <!--                <section style="flex-basis: 50%; flex-grow: 1" mayRequire="Ludeon.Rimworld.Ideology">PawnEditor_TattooBody-->
            <!--                </section>-->
            <!--                <section style="flex-basis: 50%; flex-grow: 1" mayRequire="Ludeon.Rimworld.Ideology">PawnEditor_TattooFace-->
            <!--                </section>-->
            <!--            </div>-->
        </layout>
    </PawnEditor.TabDef>
    <PawnEditor.TabDef>
        <defName>PawnEditor_Gear</defName>
        <label>Gear</label>
        <priority>20</priority>
        <tabCategory>All</tabCategory>
        <workerClass>PawnEditor.TabWorker_Pawn</workerClass>
        <layout>
            <section style="flex-basis: 100%; flex-direction: column">PawnEditor_Equipment</section>
            <section style="flex-basis: 100%; flex-direction: column">PawnEditor_Apparel</section>
            <section style="flex-basis: 100%; flex-direction: column">PawnEditor_Inventory</section>
        </layout>
    </PawnEditor.TabDef>
    <PawnEditor.TabDef>
        <defName>PawnEditor_TabDebug</defName>
        <label>Debug</label>
        <priority>-1</priority>
        <tabCategory>All</tabCategory>
        <workerClass>PawnEditor.TabWorker_Pawn</workerClass>
        <layout>
            <section>PawnEditor_Debug</section>
        </layout>
    </PawnEditor.TabDef>
</Defs>
