<?xml version="1.0" encoding="utf-8"?>

<Defs>
    <PawnEditor.TabDef>
        <defName>PawnEditor_Bio</defName>
        <label>Bio</label>
        <priority>0</priority>
        <tabCategory>All</tabCategory>
        <workerClass>PawnEditor.TabWorker_Pawn</workerClass>
        <layout class="flex flex-col">
            <div class="flex w-full justify-between">
                <div class="flex flex-col gap-section grow" style="max-width: 640px; min-width: 200px">
                    <section class="flex-col">PawnEditor_Info</section>
                    <section>PawnEditor_Name</section>
                    <section class="flex-col">PawnEditor_Age</section>
                </div>
                <section style="min-width: 80px; max-width: 160px">PawnEditor_Portrait</section>
            </div>
            <div class="items-end gap-section flex flex-wrap w-full">
            </div>
            <section>PawnEditor_Backstory</section>
            <section>PawnEditor_Faction</section>
            <section mayRequire="Ludeon.Rimworld.Ideology">PawnEditor_FavColor</section>
            <div mayRequire="Ludeon.Rimworld.Ideology" class="flex flex-wrap gap-section items-end">
                <section>PawnEditor_Ideology</section>
                <section>PawnEditor_IdeologyCertainty</section>
                <section>PawnEditor_IdeologyRole</section>
            </div>
            <div mayRequire="Ludeon.Rimworld.Royalty" class="flex flex-wrap gap-section items-end">
                <section>PawnEditor_EmpireTitle</section>
                <section>PawnEditor_EmpireHonor</section>
            </div>
            <section>PawnEditor_Traits</section>
            <section>PawnEditor_Skills</section>
            <section>PawnEditor_Abilities</section>
        </layout>
    </PawnEditor.TabDef>
    <PawnEditor.TabDef>
        <defName>PawnEditor_Appearance</defName>
        <label>Appearance</label>
        <priority>10</priority>
        <workerClass>PawnEditor.TabWorker_Pawn</workerClass>
        <layout class="flex flex-col">
            <div class="flex justify-between">
                <section dir="south">PawnEditor_Portrait</section>
                <section dir="east">PawnEditor_Portrait</section>
                <section dir="north">PawnEditor_Portrait</section>
                <section dir="west">PawnEditor_Portrait</section>
            </div>
            <section mayRequire="Ludeon.Rimworld.Biotech">PawnEditor_Xenotype</section>
            <section mayRequire="Ludeon.Rimworld.Biotech">PawnEditor_Race</section>
            <section>PawnEditor_Sex</section>
            <section mayRequire="Ludeon.Rimworld.Biotech">PawnEditor_Lifestage</section>
            <section>PawnEditor_SkinColor</section>
            <div class="block">
                <text color="Verse.ColoredText.TipSectionTitleColor">Shape</text>
                <div class="flex flex-row flex-wrap gap-section justify-start">
                    <section>PawnEditor_ShapeHead</section>
                    <section>PawnEditor_ShapeBody</section>
                </div>
            </div>
            <section>PawnEditor_HairColor</section>
            <div class="block">
                <text color="Verse.ColoredText.TipSectionTitleColor">Hair</text>
                <div class="flex flex-row flex-wrap gap-section justify-start">
                    <section>PawnEditor_Hair</section>
                    <section>PawnEditor_Beard</section>
                </div>
            </div>
            <div mayRequire="Ludeon.Rimworld.Ideology" class="block">
                <text color="Verse.ColoredText.TipSectionTitleColor">Tattoo</text>
                <div class="flex flex-row flex-wrap gap-section justify-start">
                    <section>PawnEditor_TattooBody</section>
                    <section>PawnEditor_TattooFace</section>
                </div>
            </div>
        </layout>
    </PawnEditor.TabDef>
    <PawnEditor.TabDef>
        <defName>PawnEditor_Gear</defName>
        <label>Gear</label>
        <priority>20</priority>
        <tabCategory>All</tabCategory>
        <workerClass>PawnEditor.TabWorker_Pawn</workerClass>
        <layout class="flex flex-row flex-wrap">
            <section style="min-width: 512px">PawnEditor_Equipment</section>
            <section style="min-width: 512px">PawnEditor_Apparel</section>
            <section style="min-width: 512px">PawnEditor_Inventory</section>
        </layout>
    </PawnEditor.TabDef>
    <PawnEditor.TabDef>
        <defName>PawnEditor_TabDebug</defName>
        <label>Debug</label>
        <priority>999</priority>
        <tabCategory>All</tabCategory>
        <workerClass>PawnEditor.TabWorker_Pawn</workerClass>
        <layout>
            <section>PawnEditor_Debug</section>
        </layout>
    </PawnEditor.TabDef>
</Defs>
