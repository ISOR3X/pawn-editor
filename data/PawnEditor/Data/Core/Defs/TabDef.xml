                    <section class="flex-col">PawnEditor_Info</section>
                    <section>PawnEditor_Name</section>
                    <section class="flex-col">PawnEditor_Age</section>
                </div>
                <section style="min-width: 80px; max-width: 160px">PawnEditor_Portrait</section>
            </div>
            <div class="items-end gap-section flex flex-wrap w-full">
            </div>
            <section>PawnEditor_Backstory</section>
