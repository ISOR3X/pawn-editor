<?xml version="1.0" encoding="utf-8"?>

<Defs>
    <!-- Base -->
    <PawnEditor.SectionDef Name="SectionBase_Humanlike" Abstract="True">
        <sectionCategory>Humanlike</sectionCategory>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef Name="SectionBase_LabelledButton" ParentName="SectionBase_Humanlike" Abstract="True">
        <layout>
            <div class="flex flex-row">
                <text id="text" class="w-label mr-4" color="Verse.ColoredText.TipSectionTitleColor">placeholder</text>
                <button id="button" class="w-btn"/>
            </div>
        </layout>
    </PawnEditor.SectionDef>
    <!-- Bio -->
    <PawnEditor.SectionDef>
        <defName>PawnEditor_Info</defName>
        <workerClass>PawnEditor.SectionWorker_Info</workerClass>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef>
        <defName>PawnEditor_Name</defName>
        <workerClass>PawnEditor.SectionWorker_Name</workerClass>
        <layout>
            <div class="flex flex-row">
                <text class="w-label" color="Verse.ColoredText.TipSectionTitleColor">Name</text>
                <div id="name_block" class="flex flex-wrap gap-1"/>
                <button id="generator" icon="Verse.TexButton.Rename" variant="ghost"/>
            </div>
        </layout>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef>
        <defName>PawnEditor_Age</defName>
        <workerClass>PawnEditor.SectionWorker_Age</workerClass>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_Backstory</defName>
        <workerClass>PawnEditor.SectionWorker_Backstory</workerClass>
        <layout>
            <div class="flex flex-col">
                <text class="w-label" color="Verse.ColoredText.TipSectionTitleColor">Backstory</text>
                <div class="flex flex-wrap gap-section">
                    <div class="flex flex-row">
                        <text class="w-label mr-4">Childhood</text>
                        <button id="button_childhood" class="w-btn"/>
                    </div>
                    <div class="flex flex-row">
                        <text class="w-label mr-4">Adulthood</text>
                        <button id="button_adulthood" class="w-btn"/>
                    </div>
                </div>
            </div>
        </layout>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_Abilities</defName>
        <workerClass>PawnEditor.SectionWorker_Abilities</workerClass>
        <layout>
            <div class="flex flex-col grow">
                <text class="w-label" color="Verse.ColoredText.TipSectionTitleColor">Abilities</text>
                <div id="abilities_block" class="mb-1 flex flex-wrap grow content-start p-1 w-full gap-1"/>
                <button id="add" class="ml-auto" label="Add ability"/>
            </div>
            <!--            <div style="flex-direction: column; flex-wrap: wrap; width: 100%; justify-content: space-between; max-width: 400px; flex-grow: 1; gap: 4px">-->
            <!--                <div id="abilityIcons" style="flex-wrap: wrap; gap: 4px; flex-grow: 1"/>-->
            <!--                <button id="addAbility" label="Add ability" icon="TexButton.Plus"/>-->
            <!--            </div>-->
        </layout>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_Skills</defName>
        <workerClass>PawnEditor.SectionWorker_Skills</workerClass>
        <layout>
            <div class="block w-full">
                <text class="w-label" color="Verse.ColoredText.TipSectionTitleColor">Skills</text>
                <div id="skills_grid" class="grid gap-section mb-1 justify-stretch"
                     style="grid-template-columns: repeat(auto-fill, minmax(250px, 1fr))"/>
                <button id="presets" class="ml-auto" label="Presets"/>
            </div>
        </layout>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_Traits</defName>
        <workerClass>PawnEditor.SectionWorker_Traits</workerClass>
        <layout>
            <div class="block grow">
                <div class="flex flex-wrap gap-section mb-1">
                    <div class="flex flex-col grow" style="min-width: 256px; max-width: 512px">
                        <text class="w-label" color="Verse.ColoredText.TipSectionTitleColor">Traits</text>
                        <div id="traits_block" class="flex flex-wrap grow content-start p-1 w-full gap-1"/>
                    </div>
                    <div class="flex flex-col grow" style="min-width: 256px; max-width: 512px">
                        <text class="w-label" color="Verse.ColoredText.TipSectionTitleColor">Incapable of</text>
                        <div id="incapableOf_block" class="flex flex-wrap grow content-start p-1 w-full gap-1"/>
                    </div>
                </div>
                <button id="add" class="ml-auto" label="Add trait"/>
            </div>
        </layout>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_LabelledButton">
        <defName>PawnEditor_Faction</defName>
        <workerClass>PawnEditor.SectionWorker_Faction</workerClass>
    </PawnEditor.SectionDef>
    <!-- Appearance -->
    <PawnEditor.SectionDef>
        <defName>PawnEditor_Portrait</defName>
        <workerClass>PawnEditor.SectionWorker_Portrait</workerClass>
    </PawnEditor.SectionDef>
    <!-- Appearance.Hair -->
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_Hair</defName>
        <workerClass>PawnEditor.SectionWorker_Hair</workerClass>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_Beard</defName>
        <workerClass>PawnEditor.SectionWorker_Beard</workerClass>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_HairColor</defName>
        <workerClass>PawnEditor.SectionWorker_HairColor</workerClass>
    </PawnEditor.SectionDef>
    <!-- Appearance.Shape-->
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_ShapeHead</defName>
        <workerClass>PawnEditor.SectionWorker_ShapeHead</workerClass>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_ShapeBody</defName>
        <workerClass>PawnEditor.SectionWorker_ShapeBody</workerClass>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_SkinColor</defName>
        <workerClass>PawnEditor.SectionWorker_SkinColor</workerClass>
    </PawnEditor.SectionDef>
    <!-- Appearance.Misc -->
    <PawnEditor.SectionDef ParentName="SectionBase_LabelledButton">
        <defName>PawnEditor_Sex</defName>
        <workerClass>PawnEditor.SectionWorker_Sex</workerClass>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_Lifestage</defName>
        <workerClass>PawnEditor.SectionWorker_Lifestage</workerClass>
    </PawnEditor.SectionDef>
    <!-- Gear -->
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_Equipment</defName>
        <workerClass>PawnEditor.SectionWorker_Equipment</workerClass>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_Apparel</defName>
        <workerClass>PawnEditor.SectionWorker_Apparel</workerClass>
    </PawnEditor.SectionDef>
    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_Inventory</defName>
        <workerClass>PawnEditor.SectionWorker_Inventory</workerClass>
    </PawnEditor.SectionDef>

    <PawnEditor.SectionDef ParentName="SectionBase_Humanlike">
        <defName>PawnEditor_Debug</defName>
        <workerClass>PawnEditor.SectionWorker_Debug</workerClass>
    </PawnEditor.SectionDef>
</Defs>