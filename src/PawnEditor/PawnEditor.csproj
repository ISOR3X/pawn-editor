    <Target Name="Deploy" AfterTargets="Build">
        <!-- Delete existing mod directory -->
        <RemoveDir Directories="$(RimWorldModsPath)\$(ModName)" />
        <!-- Copy static mod files -->
        <ItemGroup>
            <ModFiles Include="$(MSBuildThisFileDirectory)..\..\data\$(ModName)\**\*.*" />
        </ItemGroup>
        <Copy
                SourceFiles="@(ModFiles)"
                DestinationFiles="@(ModFiles->'$(RimWorldModsPath)\$(ModName)\%(RecursiveDir)%(Filename)%(Extension)')"
        />
