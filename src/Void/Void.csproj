<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>Void</RootNamespace>
        <AssemblyName>Void</AssemblyName>
        <ModName>Void</ModName>
        <TargetFramework>net472</TargetFramework>
        <LangVersion>latest</LangVersion>
    </PropertyGroup>
    <PropertyGroup>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
        <!-- The void_native bindings pass pinned buffers to native code. -->
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    </PropertyGroup>
    <PropertyGroup>
        <VoidNativeDir>$(MSBuildThisFileDirectory)..\..\native\void-native\</VoidNativeDir>
        <!-- rustup's default location, for shells (and IDEs) that do not have it on PATH. -->
        <CargoExe Condition="Exists('$(USERPROFILE)\.cargo\bin\cargo.exe')">$(USERPROFILE)\.cargo\bin\cargo.exe</CargoExe>
        <CargoExe Condition="'$(CargoExe)' == ''">cargo</CargoExe>
    </PropertyGroup>
    <PropertyGroup>
        <OutputPath>bin\</OutputPath>
        <PlatformTarget>AnyCPU</PlatformTarget>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <Optimize>false</Optimize>
        <DefineConstants>DEBUG;TRACE</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <DebugType>pdbonly</DebugType>
        <Optimize>true</Optimize>
        <DefineConstants>TRACE</DefineConstants>
    </PropertyGroup>
    <ItemGroup>
        <Reference Include="Taffy">
            <HintPath>..\..\lib\Taffy.dll</HintPath>
            <Private>true</Private>
        </Reference>
    </ItemGroup>
    <ItemGroup>
        <!-- Native ctaffy library — all platforms copied so the mod works on Windows, Linux, and macOS -->
        <Content Include="..\..\lib\win-x64\ctaffy.dll">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>ctaffy.dll</Link>
        </Content>
        <Content Include="..\..\lib\linux-x64\libctaffy.so">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>libctaffy.so</Link>
        </Content>
        <Content Include="..\..\lib\osx-arm64\libctaffy.dylib">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <Link>libctaffy.dylib</Link>
        </Content>
    </ItemGroup>
    <ItemGroup Condition="'$(Configuration)' == 'Debug'">
        <PackageReference Include="EditCompileReload" Version="1.0.2"/>
        <PackageReference Include="EditCompileReload.CompilerPlugin" Version="1.0.2"/>
    </ItemGroup>
    <ItemGroup>
        <Publicize Include="Assembly-CSharp"/>
    </ItemGroup>
    <!--
        Builds void_native with cargo and places it next to the other native libraries in lib/, from where
        PawnEditor deploys everything to Mods/PawnEditor/Native. Only the Windows build is produced locally.
        Set SkipVoidNative=true to build without Rust (the existing lib/win-x64/void_native.dll is then used).
    -->
    <Target Name="BuildVoidNative" BeforeTargets="BeforeBuild"
            Condition="'$(OS)' == 'Windows_NT' And '$(SkipVoidNative)' != 'true'">
        <Exec Command="&quot;$(CargoExe)&quot; build --release --manifest-path &quot;$(VoidNativeDir)Cargo.toml&quot;"/>
        <Copy SourceFiles="$(VoidNativeDir)target\release\void_native.dll"
              DestinationFolder="$(MSBuildThisFileDirectory)..\..\lib\win-x64"
              SkipUnchangedFiles="true"/>
    </Target>
    <ItemGroup>
        <!-- Embed small icons used in the components directly into the dll. -->
        <EmbeddedResource Include="Textures\*.png"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Krafs.Publicizer" Version="2.3.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4752-beta"/>
        <PackageReference Include="Lib.Harmony" Version="2.4.2"/>
    </ItemGroup>
</Project>
