<?xml version="1.0" encoding="utf-8"?>

<Defs>
    <PawnEditor.TabDef>
        <defName>PawnEditor_Bio</defName>
        <label>Bio</label>
        <priority>0</priority>
        <tabCategory>All</tabCategory>
        <workerClass>PawnEditor.TabWorker_PawnBio</workerClass>
        <layout>
            <flex direction="row">
                <section flexBasis="0.6">PawnEditor_Info</section>
                <section flexGrow="1">PawnEditor_Portrait</section>
            </flex>
            <flex direction="row">
                <section flexBasis="0.4" flexGrow="0">PawnEditor_Name</section>
                <section flexBasis="0" flexGrow="1">PawnEditor_Age</section>
                <section flexBasis="0" flexGrow="1">PawnEditor_Backstory</section>
            </flex>
            <section>PawnEditor_Skills</section>
            <flex direction="row">
                <section flexBasis="0.6" flexGrow="1">PawnEditor_Traits</section>
                <section flexBasis="0.3" flexGrow="1">PawnEditor_Abilities</section>
            </flex>
            <flex direction="row">
                <section flexBasis="0.3" flexGrow="0" mayRequire="Ludeon.Rimworld.Ideology">
                    PawnEditor_FavColor
                </section>
            </flex>
            <flex direction="row">
                <section flexBasis="0.3" flexGrow="0">PawnEditor_Faction</section>
            </flex>
        </layout>
    </PawnEditor.TabDef>
    <PawnEditor.TabDef>
        <defName>PawnEditor_Appearance</defName>
        <label>Appearance</label>
        <workerClass>PawnEditor.TabWorker_PawnAppearance</workerClass>
        <layout>
            <section flexBasis="1">PawnEditor_Portrait</section>
            <flex direction="row">
                <section flexBasis="0.3" flexGrow="1">PawnEditor_Sex</section>
                <section flexBasis="0.3" flexGrow="1" mayRequire="Ludeon.Rimworld.Biotech">PawnEditor_Lifestage</section>
                <section flexBasis="0.3" flexGrow="1" mayRequire="Ludeon.Rimworld.Biotech">PawnEditor_Race</section>
                <section flexBasis="0.3" flexGrow="1" mayRequire="Ludeon.Rimworld.Biotech">PawnEditor_Xenotype</section>
            </flex>
            <flex direction="row" wrap="true">
                <section flexBasis="0.5" flexGrow="1">PawnEditor_ShapeHead</section>
                <section flexBasis="0.5" flexGrow="1">PawnEditor_ShapeBody</section>
                <section flexBasis="1">PawnEditor_SkinColor</section>
            </flex>
            <flex direction="row" wrap="true">
                <section flexBasis="0.5" flexGrow="1">PawnEditor_Hair</section>
                <section flexBasis="0.5" flexGrow="1">PawnEditor_Beard</section>
                <section flexBasis="1">PawnEditor_HairColor</section>
            </flex>
            <!--                <li MayRequire="Ludeon.RimWorld.Ideology">PawnEditor_AppearanceTattoos</li>-->
            <!--                <li MayRequire="Ludeon.RimWorld.Biotech">PawnEditor_AppearanceXenotype</li>-->
        </layout>
    </PawnEditor.TabDef>
