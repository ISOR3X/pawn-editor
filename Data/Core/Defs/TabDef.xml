<?xml version="1.0" encoding="utf-8"?>

<Defs>
    <PawnEditor.TabDef>
        <defName>PawnEditor_Bio</defName>
        <label>Bio</label>
        <priority>0</priority>
        <tabCategory>All</tabCategory>
        <workerClass>PawnEditor.TabWorker_Pawn</workerClass>
        <layout>
            <flex direction="row">
                <section flexBasis="0.6">PawnEditor_Info</section>
                <section flexGrow="1">PawnEditor_Portrait</section>
            </flex>
            <flex direction="row" wrap="true">
                <section flexBasis="0.6">PawnEditor_Name</section>
                <section flexBasis="0.4">PawnEditor_Age</section>
                <section flexBasis="0.1" flexGrow="1" maxWidth="0.5">PawnEditor_Backstory</section>
            </flex>
            <section>PawnEditor_Skills</section>
            <flex direction="row">
                <section flexBasis="0.6" flexGrow="1">PawnEditor_Traits</section>
                <section flexBasis="0.3" flexGrow="1">PawnEditor_Abilities</section>
            </flex>
            <flex direction="row" childFlexBasis="0.33">
                <section flexBasis="0.3" flexGrow="0">PawnEditor_Faction</section>
                <section mayRequire="Ludeon.Rimworld.Ideology">
                    PawnEditor_FavColor
                </section>
            </flex>
        </layout>
    </PawnEditor.TabDef>
    <PawnEditor.TabDef>
        <defName>PawnEditor_Appearance</defName>
        <label>Appearance</label>
        <workerClass>PawnEditor.TabWorker_Pawn</workerClass>
        <layout>
            <section flexBasis="1">PawnEditor_Portrait</section>
            <flex direction="row" childFlexBasis="0.33">
                <section>PawnEditor_Sex</section>
                <section mayRequire="Ludeon.Rimworld.Biotech">PawnEditor_Lifestage</section>
                <section mayRequire="Ludeon.Rimworld.Biotech">PawnEditor_Race</section>
                <section mayRequire="Ludeon.Rimworld.Biotech">PawnEditor_Xenotype</section>
            </flex>
            <flex direction="row" wrap="true" childFlexBasis="0.5" childFlexGrow="1">
                <section>PawnEditor_ShapeHead</section>
                <section>PawnEditor_ShapeBody</section>
                <section>PawnEditor_SkinColor</section>
            </flex>
            <flex direction="row" wrap="true" childFlexBasis="0.5" childFlexGrow="1">
                <section>PawnEditor_Hair</section>
                <section>PawnEditor_Beard</section>
                <section>PawnEditor_HairColor</section>
            </flex>
            <flex direction="row" wrap="true" childFlexBasis="0.5" childFlexGrow="1" mayRequire="Ludeon.Rimworld.Ideology">
                <section>PawnEditor_TattooBody</section>
                <section>PawnEditor_TattooFace</section>
            </flex>
        </layout>
    </PawnEditor.TabDef>
    <PawnEditor.TabDef>
        <defName>PawnEditor_Gear</defName>
        <label>Gear</label>
        <workerClass>PawnEditor.TabWorker_Pawn</workerClass>
        <layout>
            <section>PawnEditor_Equipment</section>
            <section>PawnEditor_Apparel</section>
            <section>PawnEditor_Inventory</section>
        </layout>
    </PawnEditor.TabDef>
</Defs>